APP_NAME=python-ai-service
APP_ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Required external dependency. No production security bypass exists in the archetype.
GEN_SECURITY_BASE_URL=http://localhost:8080
GEN_SECURITY_VALIDATE_TOKEN_PATH=/internal/validateToken
GEN_SECURITY_USE_BASIC_AUTH=false
